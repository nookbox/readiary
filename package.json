{
  "name": "readiary",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @readiary/api dev",
    "dev:mobile": "pnpm --filter @readiary/mobile start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @readiary/api db:generate",
    "db:migrate": "pnpm --filter @readiary/api db:migrate",
    "db:push": "pnpm --filter @readiary/api db:push",
    "db:studio": "pnpm --filter @readiary/api db:studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  }
}
