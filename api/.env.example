# --- API ---
PORT=4000
NODE_ENV=development

# --- Database ---
# docker-compose.yml 의 postgres 서비스 기준 (호스트 포트 5433)
DATABASE_URL=postgresql://readiary:readiary@localhost:5436/readiary

# --- 카카오 책 검색 API ---
# https://developers.kakao.com 에서 앱을 만들고 REST API 키를 넣는다
KAKAO_REST_API_KEY=

# --- Auth (better-auth RP ← nook IdP) ---
# 쿠키/세션 서명 시크릿. IdP·nookbox 와 다른 값으로 (openssl rand -hex 32)
BETTER_AUTH_SECRET=
# RP 자기 자신의 base URL. IdP 콜백 = ${BETTER_AUTH_URL}/api/auth/callback/nook-auth
BETTER_AUTH_URL=http://localhost:4000
# 모바일 딥링크 (app.json scheme)
APP_URL=readiary://

# idp-new (OIDC IdP) 에 readiary 용으로 등록한 클라이언트
OIDC_ISSUER=http://localhost:3001/api/auth
OIDC_PROVIDER_ID=nook-auth
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
