# --- API ---
PORT=4000
NODE_ENV=development

# --- Database ---
# docker-compose.yml 의 postgres 서비스 기준 (호스트 포트 5433)
DATABASE_URL=postgresql://readiary:readiary@localhost:5436/readiary

# --- 알라딘 TTB API ---
# https://www.aladin.co.kr/ttb/wblog_manage.aspx 에서 발급
ALADIN_TTB_KEY=

# --- IdP (nook auth) ---
IDP_ISSUER=
IDP_AUDIENCE=readiary
IDP_JWKS_URI=
