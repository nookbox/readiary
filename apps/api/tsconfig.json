{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "../../packages/shared/src/**/*", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
